datasource db {
  provider = "postgresql"
}

generator client {
  provider = "prisma-client-js"
}

model Paciente {
  id               Int      @id @default(autoincrement())
  nombre           String
  email            String   @unique
  telefono         String
  fechaNacimiento  DateTime
  historialMedico  String?
  citas            Cita[]
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@map("pacientes")
}

model Doctor {
  id             Int      @id @default(autoincrement())
  nombre         String
  email          String   @unique
  especialidad   String
  telefono       String
  cualificaciones String?
  citas          Cita[]
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@map("doctores")
}

model Cita {
  id          Int      @id @default(autoincrement())
  pacienteId  Int
  doctorId    Int
  fechaCita   DateTime
  estado      EstadoCita @default(PENDIENTE)
  notas       String?

  paciente    Paciente @relation(fields: [pacienteId], references: [id])
  doctor      Doctor   @relation(fields: [doctorId], references: [id])

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("citas")
}

enum EstadoCita {
  PENDIENTE
  CONFIRMADA
  CANCELADA
  REPROGRAMADA
}

model User {
  id        Int      @id @default(autoincrement())
  nombre    String
  email     String   @unique
  password  String
  createdAt DateTime @default(now())

  @@map("users")
}